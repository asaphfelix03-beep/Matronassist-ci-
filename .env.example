# Copier en `.env` pour le développement local.

# --- Base de données --------------------------------------------------------
# PostgreSQL, en développement comme en production (un seul schéma Prisma).
# Offres gratuites suffisantes pour démarrer: Neon, Supabase, Vercel Postgres.
DATABASE_URL="postgresql://UTILISATEUR:MOTDEPASSE@HOTE:5432/BASE?sslmode=require"

# Connexion directe, obligatoire: `prisma migrate` exécute du DDL, qu'un pool en
# mode transaction (PgBouncer chez Neon, Supabase, Vercel Postgres) ne supporte pas.
# Avec un pool, DATABASE_URL pointe vers le pool et DIRECT_URL vers la base.
# Sans pool, reprenez simplement la même valeur que DATABASE_URL.
DIRECT_URL="postgresql://UTILISATEUR:MOTDEPASSE@HOTE:5432/BASE?sslmode=require"

# --- Création du premier administrateur -------------------------------------
# Utilisé uniquement par `npm run create-admin`. Sans ADMIN_PASSWORD, un mot de
# passe provisoire est généré et affiché une seule fois.
# ADMIN_EMAIL="admin@structure.ci"
# ADMIN_NAME="Nom Prénom"
# ADMIN_PASSWORD=

# --- Appels audio/vidéo (WebRTC) --------------------------------------------
# Des serveurs STUN publics sont utilisés par défaut et suffisent dans la plupart
# des cas. Un serveur TURN est nécessaire pour que les appels aboutissent derrière
# les NAT symétriques et certains réseaux d'entreprise (10 à 20 % des cas).
# Ces variables sont exposées au navigateur: n'y mettez qu'un identifiant TURN
# dédié, idéalement à durée de vie limitée.
# NEXT_PUBLIC_TURN_URL="turn:turn.exemple.ci:3478"
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# --- Déploiement Vercel (secrets du dépôt GitHub) ---------------------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
