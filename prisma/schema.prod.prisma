generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Matrone {
  id         String   @id @default(cuid())
  name       String
  region     String
  email      String?
  phone      String?
  patients   Int      @default(0)
  status     String   @default("active")
  lastActive String
  createdAt  DateTime @default(now())
}
