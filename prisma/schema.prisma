generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Matrone {
  id         String   @id @default(cuid())
  name       String
  region     String
  email      String?
  phone      String?
  patients   Int      @default(0)
  status     String   @default("active")
  lastActive String
  createdAt  DateTime @default(now())
}
